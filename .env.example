# Environment variables read by chess-coach. The code reads them from the process
# environment; it does not load this file itself. Export them in your shell, or put them
# in the "env" block of your MCP client config (see README).

# SQLite cache for games and analysis. Default: ~/.chess_coach/games.db
CHESS_COACH_DB=./.data/games.db

# Path to a Stockfish binary. Default: engines/stockfish/... in the repo, then `stockfish` on PATH.
CHESS_COACH_STOCKFISH=/usr/local/bin/stockfish

# chess.com username the web dashboard opens with (optional; the MCP tools take it per call).
CHESS_COACH_USER=sample_player
